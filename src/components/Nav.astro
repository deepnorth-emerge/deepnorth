---
// Stripped top bar. Active link computed from the current path.
// Three pages only: home, The Work, The Perspective Engine.
// About, Speaking and Contact were folded into The Work.
const path = (Astro.url.pathname.replace(/\/+$/, "") || "/");
const links = [
  { href: "/the-work", label: "The Work" },
  { href: "/perspective-engine", label: "Perspective Engine" },
];
---
<header class="site-nav">
  <div class="nav-bar">
    <a href="/" class="mark">Deep North</a>
    <nav class="nav-links" aria-label="Main navigation">
      {links.map((l) => (
        <a href={l.href} class={path === l.href ? "active" : ""}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
