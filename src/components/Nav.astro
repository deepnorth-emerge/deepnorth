---
// Stripped top bar. Active link computed from the current path.
// Minimal by design — Deep North (home), Speaking, About.
// The Work, Perspective Engine and Contact are reached from the
// home index. If you'd rather they sit in the bar too, add them
// to the `links` array below.
const path = (Astro.url.pathname.replace(/\/+$/, "") || "/");
const links = [
  { href: "/speaking", label: "Speaking" },
  { href: "/about", label: "About" },
];
---
<header class="site-nav">
  <div class="nav-bar">
    <a href="/" class="mark">Deep North</a>
    <nav class="nav-links" aria-label="Main navigation">
      {links.map((l) => (
        <a href={l.href} class={path === l.href ? "active" : ""}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
