---
// Stripped top bar. Active link computed from the current path.
// Pages: home, The Book, The Work, The Perspective Engine.
// About, Speaking and Contact were folded into The Work.
const path = (Astro.url.pathname.replace(/\/+$/, "") || "/");
const links = [
  { href: "/books", label: "The Book" },
  { href: "/the-work", label: "The Work" },
  { href: "/perspective-engine", label: "Perspective Engine" },
];
---
<header class="site-nav">
  <div class="nav-bar">
    <a href="/" class="mark">Deep North</a>
    <nav class="nav-links" aria-label="Main navigation">
      {links.map((l) => (
        <a href={l.href} class={path === l.href ? "active" : ""}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Four items no longer fit on one line on a phone: let the links drop under the mark */
  .nav-bar { flex-wrap: wrap; row-gap: 0.5rem; }
  .nav-links { flex-wrap: wrap; row-gap: 0.25rem; }
</style>
