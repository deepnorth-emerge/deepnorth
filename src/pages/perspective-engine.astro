---
import BaseLayout from '../layouts/BaseLayout.astro';
import PerspectiveEngine from '../components/PerspectiveEngine.jsx';
---

<BaseLayout
  title="The Perspective Engine"
  description="An interactive experience of binary cognition in action — and what shifts when you notice it."
>

  <!-- Hero -->
  <section style="padding: 5rem 1.5rem 2rem; text-align: center;">
    <div style="max-width: 560px; margin: 0 auto;">
      <p class="eyebrow" style="margin: 0 0 1.25rem;">Interactive Experience</p>
      <h1 style="font-family: 'Source Serif 4', Georgia, serif; font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 700; line-height: 1.15; color: #1A1A1A; margin: 0 0 1rem;">
        The Perspective Engine
      </h1>
    </div>
  </section>

  <!-- Engine -->
  <section style="padding: 1rem 1.5rem 6rem;">
    <div class="prose-container">
      <PerspectiveEngine client:load />
    </div>
  </section>

  <!-- Context below -->
  <section style="padding: 3rem 1.5rem 5rem; background-color: #F0EDE6; border-top: 1px solid #D4CFC5;">
    <div class="prose-container">
      <p class="eyebrow" style="margin: 0 0 1.25rem;">About this tool</p>
      <p style="font-family: 'Inter', system-ui, sans-serif; font-size: 0.92rem; line-height: 1.8; color: #444; max-width: 540px;">
        The Perspective Engine is a short experiential sequence designed to demonstrate how binary
        cognition operates in real time — and what different cognitive operations feel like from the inside.
        It stores no data. It has no right answers. It's an experience, not a test.
      </p>
      <div style="margin-top: 1.75rem;">
        <a href="/the-work" class="arrow-link">Read the framework behind it &rarr;</a>
      </div>
    </div>
  </section>

</BaseLayout>
